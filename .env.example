# ==========================================
# Database — PostgreSQL
# ==========================================

POSTGRES_USER=oqs_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=o_que_sobrou

# Connection string used by the API.
# Adjust the host and port according to your environment.
DATABASE_URL="postgresql://oqs_user:change_me@localhost:5433/o_que_sobrou"

# ==========================================
# API
# ==========================================

PORT=3000
APP_URL="http://localhost:3000"

# ==========================================
# Authentication — JWT
# ==========================================

# Replace with a strong, unique secret.
JWT_SECRET="replace_with_a_secure_random_secret"

# Access token expiration.
JWT_EXPIRES_IN="15m"

# Configure this only if the application uses it.
JWT_REFRESH_SECRET="replace_with_a_different_secure_random_secret"

# ==========================================
# Email — Resend
# ==========================================

RESEND_API_KEY="re_replace_with_your_resend_api_key"
EMAIL_FROM="O que Sobrou <onboarding@resend.dev>"
